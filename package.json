{
  "name": "bead-studio",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Turn any image into a bead / perler pattern in the browser. No login, no upload, no backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:palettes": "node scripts/gen-palettes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
